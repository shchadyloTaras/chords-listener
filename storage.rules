rules_version = '2';

// Cloud Storage for Firebase (default bucket build-chords-listener.firebasestorage.app), docs/CLOUD.md.
//
// Uploads: the site uploads big files and tab recordings to users/{uid}/uploads/{uploadId}/{fileName}; the
// API (Cloud Run, its own service account, not bound by these rules) reads, ingests and deletes them.
// Clients may only create their own uploads: ≤ 500 MB, audio/*, video/* or application/octet-stream.
// Nothing of an upload can be read, listed or changed from the client.
//
// Library: the API publishes every track (docs/CLOUD.md → Library in Firestore) and the signed-in site
// reads these files straight from here with the Storage SDK (getBytes), only its owner:
//   users/{uid}/tracks/{trackId}/track.json | notes.json | vocals.json | audio.mp3
//   users/{uid}/tracks/{trackId}/stems/vocals.mp3 | instruments.mp3
// Clients never write them. Audio and stems are streamed through Firebase download-token URLs, which do not
// go through these rules (the token in track.json is the credential). Everything else in the bucket
// (meta.json, analysis.json, edits.json, quota.json, publish-pending.json, listings) is off limits.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/uploads/{uploadId}/{fileName} {
      allow read: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && uploadId.size() <= 128
        && fileName.size() <= 255
        && request.resource.size > 0
        && request.resource.size <= 500 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('video/.*')
            || request.resource.contentType == 'application/octet-stream');
      // a client may cancel (remove) its own pending upload
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }

    // The published library: the owner reads, only the API writes.
    match /users/{uid}/tracks/{trackId}/{file} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && file in ['track.json', 'notes.json', 'vocals.json', 'audio.mp3'];
      allow write: if false;
    }
    match /users/{uid}/tracks/{trackId}/stems/{stem} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && stem in ['vocals.mp3', 'instruments.mp3'];
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
